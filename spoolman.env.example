# Optional: Spoolman's database on a PostgreSQL server instead of its SQLite file. Copy to spoolman.env and restrict it
# (cp spoolman.env.example spoolman.env && chmod 600 spoolman.env); spoolman.env is gitignored. Without it, Spoolman
# keeps its SQLite database in its folder. Don't leave a setting here empty: Spoolman refuses to start with one.
#
# The password isn't here: it goes in CONFIG_ROOT/spoolman/secrets/db_password (docs/installing.md#spoolmans-database).
# The database and its login must exist first, and Spoolman doesn't move its data over by itself.
SPOOLMAN_DB_TYPE=postgres
SPOOLMAN_DB_HOST=db.example.com
SPOOLMAN_DB_PORT=5432
SPOOLMAN_DB_NAME=spoolman
SPOOLMAN_DB_USERNAME=spoolman
# Encrypt the connection (Spoolman doesn't by itself).
SPOOLMAN_DB_QUERY=ssl=require
