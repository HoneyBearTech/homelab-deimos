# Settings for one homelab-deimos installation. Copy to .env and restrict it (cp .env.example .env &&
# chmod 600 .env); .env is gitignored and never committed. Every setting the stack reads is listed here and in
# docs/interfaces.md.
#
# No secrets belong in this file. Each service keeps its own logins, tokens and keys in its data directory.

# On a host with an NVIDIA GPU and the NVIDIA Container Toolkit, give Tdarr the GPU by uncommenting this line.
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml

# Time zone for logs and schedules (a tz database name).
TZ=Etc/UTC

# The user and group Tdarr, Spoolman and the AMS app run as. Tdarr's must be able to read and write the media library.
PUID=1000
PGID=1000

# The media library Tdarr processes. Tdarr rewrites files here: it is never backed up by scripts/backup.sh, so
# protect it on the storage that holds it (snapshots).
MEDIA_PATH=/srv/media

# Where every app keeps its data on the host, one folder per app: CONFIG_ROOT/<app>/config holds its settings and
# database, and any other folder it needs sits beside that (tdarr/server, tdarr/logs, tdarr/transcode,
# haspelsync/logs; docs/installing.md#where-data-lives). Create them as your user before the first start. The Dozzle
# agent's certificate and key go in dozzle/certs, owned by root, the same pair as the Dozzle hub's; not backed up
# (docs/installing.md#dozzles-certificate). Never point
# this into /var/lib/docker/volumes: `docker volume prune` deletes what is there. The logs and the transcode cache
# aren't backed up; the AMS app's printer list (haspelsync/config) holds the printers' access codes in plain text, so
# its backups are secret.
CONFIG_ROOT=/srv/config

# The URL your browser reaches Spoolman at; the AMS app's links point there. Not a secret, but it names your host.
SPOOLMAN_PUBLIC_URL=http://spoolman.example.com:7912
