# Settings for one homelab-deimos installation. Copy to .env and restrict it (cp .env.example .env &&
# chmod 600 .env); .env is gitignored and never committed. Every setting the stack reads is listed here and in
# docs/interfaces.md.
#
# No secrets belong in this file. Each service keeps its own logins, tokens and keys in its data directory.

# On a host with an NVIDIA GPU and the NVIDIA Container Toolkit, give Tdarr the GPU by uncommenting this line.
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml

# Time zone for logs and schedules (a tz database name).
TZ=Etc/UTC

# The user and group Tdarr and Spoolman run as. Tdarr's must be able to read and write the media library.
PUID=1000
PGID=1000

# The media library Tdarr processes. Tdarr rewrites files here: it is never backed up by scripts/backup.sh, so
# protect it on the storage that holds it (snapshots).
MEDIA_PATH=/srv/media

# Tdarr's server database, settings and logs: host directories. Back them up before every upgrade
# (docs/upgrading.md); the logs aren't backed up.
TDARR_SERVER_PATH=/srv/appdata/tdarr/server
TDARR_CONFIGS_PATH=/srv/appdata/tdarr/configs
TDARR_LOGS_PATH=/srv/appdata/tdarr/logs

# Scratch space for transcodes in progress. Needs room for several of your largest files; not backed up.
TDARR_CACHE_PATH=/srv/transcode-cache

# Spoolman's database: a host directory.
SPOOLMAN_DATA_PATH=/srv/appdata/spoolman

# The URL your browser reaches Spoolman at; the AMS app's links point there. Not a secret, but it names your host.
SPOOLMAN_PUBLIC_URL=http://spoolman.example.com:7912

# The AMS app's printer list (serial numbers, addresses and access codes, in plain text) and its logs: host
# directories. The printer list is backed up and the backup is secret; the logs aren't backed up.
AMS_PRINTERS_PATH=/srv/appdata/ams/printers
AMS_LOGS_PATH=/srv/appdata/ams/logs
