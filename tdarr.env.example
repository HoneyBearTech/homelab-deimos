# Copy to tdarr.env, mode 600; gitignored. Include compose.tdarr-auth.yaml in COMPOSE_FILE.
# Generate one key with: openssl rand -hex 32
# Prefix it with tapi_ and paste the same key after both equals signs below. Do not start with empty keys.
# For a new installation the seeded key also becomes the initial admin password; change that password after login.
# Existing accounts keep their passwords. Never reuse this key outside Tdarr.
seededApiKey=
apiKey=
